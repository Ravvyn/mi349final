---
title: Lynn Hogen-Esch - Portfolio
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lynn Hogen-Esch - Portfolio</title>
  <link rel="stylesheet" href="/styles/screen.css">
</head>
<body>
  <div class="wrapper">
    <main>
      <div class="about">
        <div class="profile">
          <img src="/images/Face.png/" alt="Lynn Hogen-Esch's Face">
        </div>
        <div class="profiledesc">
          <h3>Lynn Hogen-Esch</h3>
          <h4>UI/UX Designer <br> Systems Programmer</h4>
          <p>Hi there! Welcome to my portfolio! I'm a game developer specializing in UI/UX design and systems programming. I'm currently a student at Michigan State University, majoring in Games and Interactive Media. I'm also the founding President of Gamma Iota Mu, the first-of-its-kind gender inclusive professional fraternity for game developers!</p>
        </div>
      </div>
      <div class="gameContainer">
        {% for game in games %}
          {% if game.Indev == false %}
            <div class="Game">
              <a href="/{{ game.name | slugify }}/"><img src="{{ game.CoverImage }}" alt="{{game.name}} cover image"></a>
              <h2>{{ game.name }}</h2>
              <p>{{ game.mainDescription }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% comment %}
      <h1>~~In Development~~</h1>
      <div class="gameContainer">
        <div></div>
        {% for game in games %}
          {% if game.Indev == true %}
            <div class="Game">
              <a href="/portfolio/{{ game.name | slugify }}/"><img src="{{ game.CoverImage }}" alt="{{game.name}} cover image"></a>
              <h2>{{ game.name }}</h2>
              <p>{{ game.mainDescription }}</p>
            </div>
          {% endif %}
        {% endfor %}
        <div></div>
      </div>
      {% endcomment %}
    </main>
    {% include 'footer' %}
  </div>
</body>
</html>